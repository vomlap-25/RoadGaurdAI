# Copy to .env for local use. Never commit .env or AWS credentials.
APP_NAME=RoadGuard AI
APP_ENV=development
LOG_LEVEL=INFO

# Vision (provide a compatible, licensed model separately; do not put it in source control unless licensed)
ROADGUARD_ONNX_MODEL=models/road_damage.onnx
ROADGUARD_CLASS_NAMES=pothole,crack
ROADGUARD_MODEL_INPUT_SIZE=640
ROADGUARD_CONFIDENCE_THRESHOLD=0.25
ROADGUARD_BLUR_THRESHOLD=35
ROADGUARD_DARK_THRESHOLD=35

# Local default. SQLite and local evidence require persistent Docker volumes in deployment.
ROADGUARD_STORAGE_BACKEND=sqlite
ROADGUARD_DATABASE_PATH=artifacts/roadguard.sqlite3
ROADGUARD_UPLOAD_DIR=uploads
ROADGUARD_EVIDENCE_DIR=artifacts/evidence
ROADGUARD_MAX_UPLOAD_BYTES=104857600

# Optional AWS evidence storage (uses S3 only when bucket is set)
AWS_REGION=us-east-1
ROADGUARD_S3_BUCKET=
ROADGUARD_S3_PREFIX=evidence

# Optional DynamoDB metadata backend. Set backend=dynamodb and table name together.
# ROADGUARD_STORAGE_BACKEND=dynamodb
ROADGUARD_DYNAMODB_TABLE=
